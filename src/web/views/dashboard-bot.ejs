<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard • <%= bot.bot_name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white">
  <header class="bg-gradient-to-r from-violet-700 to-blue-500 p-6 shadow-2xl flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Dashboard • <%= bot.bot_name %></h1>
      <p class="text-sm opacity-80">Visão geral do bot selecionado</p>
    </div>
    <div class="flex gap-3">
      <a href="/bots" class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Voltar para bots</a>
      <form method="POST" action="/logout">
        <button class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Sair</button>
      </form>
    </div>
  </header>
  <main class="p-8 space-y-8">
    <section class="grid md:grid-cols-4 gap-6">
      <div class="bg-slate-900 border border-violet-600 rounded-xl p-6">
        <p class="text-xs uppercase text-violet-300">Faturamento</p>
        <h2 class="text-2xl font-bold">R$ <%= revenue.toFixed(2) %></h2>
      </div>
      <div class="bg-slate-900 border border-violet-600 rounded-xl p-6">
        <p class="text-xs uppercase text-violet-300">Vendas</p>
        <h2 class="text-2xl font-bold"><%= sales.length %></h2>
      </div>
      <div class="bg-slate-900 border border-violet-600 rounded-xl p-6">
        <p class="text-xs uppercase text-violet-300">Pendentes</p>
        <h2 class="text-2xl font-bold"><%= pending.length %></h2>
      </div>
      <div class="bg-slate-900 border border-violet-600 rounded-xl p-6">
        <p class="text-xs uppercase text-violet-300">Produtos</p>
        <h2 class="text-2xl font-bold"><%= products.length %></h2>
      </div>
    </section>

    <section class="grid md:grid-cols-2 gap-6">
      <div class="bg-slate-900 border border-blue-500 rounded-xl p-6">
        <h3 class="text-xl font-semibold mb-4">Últimas Vendas</h3>
        <ul class="space-y-2">
          <% sales.slice(0, 10).forEach((sale) => { %>
            <li class="flex justify-between text-sm">
              <span><%= sale.produto %></span>
              <span class="text-blue-300">R$ <%= sale.valor.toFixed(2) %></span>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="bg-slate-900 border border-blue-500 rounded-xl p-6">
        <h3 class="text-xl font-semibold mb-4">Cupons Ativos</h3>
        <ul class="space-y-2">
          <% coupons.forEach((coupon) => { %>
            <li class="flex justify-between text-sm">
              <span><%= coupon.code %></span>
              <span class="text-violet-300"><%= coupon.type %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>

    <div class="flex gap-3">
      <a href="/bots/<%= bot.id %>/products" class="bg-violet-600 px-4 py-2 rounded">Gerenciar Produtos</a>
      <a href="/bots" class="bg-slate-800 px-4 py-2 rounded">Voltar</a>
    </div>
  </main>
</body>
</html>
