<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Produtos • <%= bot.bot_name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white">
  <header class="bg-gradient-to-r from-violet-700 to-blue-500 p-6 shadow-2xl flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Produtos • <%= bot.bot_name %></h1>
      <p class="text-sm opacity-80">Catálogo e estoque do bot</p>
    </div>
    <div class="flex gap-3">
      <a href="/dashboard/<%= bot.id %>" class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Voltar</a>
      <form method="POST" action="/logout">
        <button class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Sair</button>
      </form>
    </div>
  </header>
  <main class="p-8 space-y-8">
    <form method="POST" action="/bots/<%= bot.id %>/products" class="bg-slate-900 p-6 rounded-xl border border-violet-600 space-y-4">
      <h2 class="text-xl font-semibold">Novo Produto</h2>
      <input name="name" placeholder="Nome" class="w-full p-3 rounded bg-slate-800" required />
      <input name="category" placeholder="Categoria" class="w-full p-3 rounded bg-slate-800" required />
      <input name="price" type="number" step="0.01" placeholder="Preço" class="w-full p-3 rounded bg-slate-800" required />
      <input name="stock" type="number" placeholder="Estoque" class="w-full p-3 rounded bg-slate-800" />
      <input name="image_url" placeholder="URL da imagem" class="w-full p-3 rounded bg-slate-800" />
      <textarea name="description" placeholder="Descrição" class="w-full p-3 rounded bg-slate-800"></textarea>
      <button class="bg-violet-600 px-4 py-2 rounded">Criar</button>
    </form>

    <table class="w-full text-sm border border-blue-600 rounded-xl overflow-hidden">
      <thead class="bg-slate-900">
        <tr>
          <th class="p-3 text-left">Produto</th>
          <th class="p-3">Categoria</th>
          <th class="p-3">Preço</th>
          <th class="p-3">Estoque</th>
          <th class="p-3">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach((product) => { %>
          <tr class="border-t border-slate-800">
            <td class="p-3"><%= product.name %></td>
            <td class="p-3 text-center"><%= product.category %></td>
            <td class="p-3 text-center">R$ <%= product.price.toFixed(2) %></td>
            <td class="p-3 text-center"><%= product.stock %></td>
            <td class="p-3 text-center">
              <div class="flex items-center justify-center gap-2">
                <a href="/bots/<%= bot.id %>/products/<%= product.id %>/edit" class="bg-blue-600 px-3 py-1 rounded">Editar</a>
                <form method="POST" action="/bots/<%= bot.id %>/products/<%= product.id %>/delete">
                  <button class="bg-red-600 px-3 py-1 rounded">Remover</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
