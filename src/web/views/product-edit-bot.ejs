<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editar Produto • <%= bot.bot_name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white">
  <header class="bg-gradient-to-r from-violet-700 to-blue-500 p-6 shadow-2xl flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold">Editar Produto • <%= bot.bot_name %></h1>
      <p class="text-sm opacity-80">Atualize nome, descrição, preço, categoria, estoque, imagem e status.</p>
    </div>
    <div class="flex gap-3">
      <a href="/bots/<%= bot.id %>/products" class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Voltar</a>
      <form method="POST" action="/logout">
        <button class="bg-slate-900/60 border border-blue-300 px-4 py-2 rounded-lg">Sair</button>
      </form>
    </div>
  </header>

  <main class="p-8">
    <form method="POST" action="/bots/<%= bot.id %>/products/<%= product.id %>/edit" class="bg-slate-900 p-6 rounded-xl border border-violet-600 space-y-4 max-w-3xl">
      <div>
        <label class="block text-sm mb-2">Nome</label>
        <input name="name" value="<%= product.name %>" class="w-full p-3 rounded bg-slate-800" required />
      </div>

      <div>
        <label class="block text-sm mb-2">Descrição</label>
        <textarea name="description" class="w-full p-3 rounded bg-slate-800" rows="4"><%= product.description %></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm mb-2">Preço</label>
          <input name="price" type="number" step="0.01" value="<%= product.price %>" class="w-full p-3 rounded bg-slate-800" required />
        </div>
        <div>
          <label class="block text-sm mb-2">Estoque</label>
          <input name="stock" type="number" value="<%= product.stock %>" class="w-full p-3 rounded bg-slate-800" required />
        </div>
      </div>

      <div>
        <label class="block text-sm mb-2">Categoria</label>
        <input name="category" value="<%= product.category %>" class="w-full p-3 rounded bg-slate-800" required />
      </div>

      <div>
        <label class="block text-sm mb-2">URL da imagem</label>
        <input name="image_url" value="<%= product.image_url || '' %>" class="w-full p-3 rounded bg-slate-800" />
      </div>

      <label class="flex items-center gap-2">
        <input type="checkbox" name="active" <%= Number(product.active) ? 'checked' : '' %> />
        <span>Produto ativo</span>
      </label>

      <button class="bg-violet-600 px-4 py-2 rounded">Salvar alterações</button>
    </form>
  </main>
</body>
</html>
