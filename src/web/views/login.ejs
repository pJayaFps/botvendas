<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login • VIA BOT</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white flex items-center justify-center">
  <div class="w-full max-w-md bg-slate-900 border border-violet-600 rounded-2xl p-8">
    <h1 class="text-2xl font-bold mb-4">Login Premium</h1>
    <% if (typeof error !== 'undefined') { %>
      <p class="text-red-400 mb-4"><%= error %></p>
    <% } %>
    <form method="POST" action="/login" class="space-y-4">
      <input name="email" type="email" placeholder="E-mail" class="w-full p-3 rounded bg-slate-800" required />
      <input name="password" type="password" placeholder="Senha" class="w-full p-3 rounded bg-slate-800" required />
      <button class="w-full bg-violet-600 py-3 rounded-lg">Entrar</button>
    </form>
    <div class="mt-4 flex items-center justify-between text-sm">
      <a class="text-blue-400" href="/register">Cadastrar</a>
      <a class="text-blue-400" href="/login">Voltar ao login</a>
    </div>
  </div>
</body>
</html>
