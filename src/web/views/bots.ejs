<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bots • VIA BOT</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white">
  <header class="bg-gradient-to-r from-violet-700 to-blue-500 p-6 shadow-2xl">
    <h1 class="text-3xl font-bold">Seus Bots</h1>
  </header>
  <main class="p-8 space-y-8">
    <form method="POST" action="/bots" class="bg-slate-900 p-6 rounded-xl border border-violet-600 space-y-4">
      <h2 class="text-xl font-semibold">Cadastrar novo bot</h2>
      <input name="bot_name" placeholder="Nome do bot" class="w-full p-3 rounded bg-slate-800" required />
      <input name="bot_token" placeholder="Token do bot" class="w-full p-3 rounded bg-slate-800" required />
      <button class="bg-violet-600 px-4 py-2 rounded">Adicionar</button>
    </form>

    <section class="grid md:grid-cols-2 gap-6">
      <% bots.forEach((bot) => { %>
        <div class="bg-slate-900 border border-blue-500 rounded-xl p-6">
          <h3 class="text-xl font-semibold"><%= bot.bot_name %></h3>
          <p class="text-sm text-blue-300">Status: <%= bot.status %></p>
          <a href="/dashboard/<%= bot.id %>" class="inline-block mt-4 bg-blue-600 px-4 py-2 rounded">Abrir Dashboard</a>
        </div>
      <% }) %>
    </section>
  </main>
</body>
</html>
